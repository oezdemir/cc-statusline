#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""
Claude Code Usage - Statusline script
Receives JSON from Claude Code via stdin when used as statusline command.
Fetches usage limits via OAuth API (no pexpect needed).

Usage:
  claude-usage           # Default output
  claude-usage compact   # Compact single-line
  claude-usage json      # JSON output
"""

import sys
import os
import json
import subprocess
import platform
from datetime import datetime, timezone
from pathlib import Path
from urllib.request import Request, urlopen

CACHE_FILE = Path("/tmp/claude_usage_cache.json")
CACHE_LOCK = Path("/tmp/claude_usage_cache.lock")
CACHE_MAX_AGE = 300  # 5 minutes
STDIN_CAPTURE = Path(__file__).parent / "test_data" / "captured_stdin.json"

DEBUG = os.environ.get("DEBUG", "0") == "1"

def debug(msg):
    if DEBUG:
        print(f"DEBUG: {msg}", file=sys.stderr)


# ── Token retrieval ──────────────────────────────────────────────────

def get_oauth_token() -> str | None:
    """Get OAuth access token. Linux: credentials file. macOS: keychain."""
    if platform.system() == "Darwin":
        try:
            creds_json = subprocess.check_output(
                ["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
                stderr=subprocess.DEVNULL, text=True,
            ).strip()
            return json.loads(creds_json).get("claudeAiOauth", {}).get("accessToken")
        except (subprocess.CalledProcessError, json.JSONDecodeError):
            return None
    else:
        creds_path = Path.home() / ".claude" / ".credentials.json"
        if not creds_path.exists():
            return None
        try:
            creds = json.loads(creds_path.read_text())
            return creds.get("claudeAiOauth", {}).get("accessToken")
        except (json.JSONDecodeError, OSError):
            return None


# ── Usage API ────────────────────────────────────────────────────────

def fetch_usage() -> dict | None:
    """Fetch usage data from the OAuth API."""
    token = get_oauth_token()
    if not token:
        debug("no oauth token found")
        return None

    req = Request(
        "https://api.anthropic.com/oauth/usage",
        headers={
            "accept": "application/json",
            "anthropic-beta": "oauth-2025-04-20",
            "authorization": f"Bearer {token}",
            "user-agent": "cc-statusline/1.0",
        },
    )
    try:
        with urlopen(req, timeout=5) as resp:
            return json.loads(resp.read())
    except Exception as e:
        debug(f"API error: {e}")
        return None


def save_cache(usage_json: dict):
    """Save usage JSON to cache file."""
    CACHE_FILE.write_text(json.dumps(usage_json))


def load_cache() -> dict | None:
    """Load usage JSON from cache file."""
    try:
        return json.loads(CACHE_FILE.read_text())
    except (json.JSONDecodeError, OSError):
        return None


# ── Caching ──────────────────────────────────────────────────────────

def cache_is_valid() -> bool:
    if not CACHE_FILE.exists():
        return False
    age = datetime.now().timestamp() - CACHE_FILE.stat().st_mtime
    return age < CACHE_MAX_AGE


def update_in_progress() -> bool:
    if not CACHE_LOCK.exists():
        return False
    age = datetime.now().timestamp() - CACHE_LOCK.stat().st_mtime
    if age > 30:
        CACHE_LOCK.unlink(missing_ok=True)
        return False
    return True


def start_background_update():
    if update_in_progress():
        return
    CACHE_LOCK.touch()
    env = os.environ.copy()
    env.pop("CLAUDECODE", None)
    subprocess.Popen(
        [sys.executable, __file__, "--update"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True, env=env,
    )


def do_cache_update():
    try:
        data = fetch_usage()
        if data:
            save_cache(data)
            debug("cache updated")
    finally:
        CACHE_LOCK.unlink(missing_ok=True)


# ── Stdin parsing ────────────────────────────────────────────────────

def parse_stdin_json() -> dict | None:
    if sys.stdin.isatty():
        return None
    try:
        return json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return None


def format_tokens(tokens: int) -> str:
    if tokens >= 1000:
        return f"{tokens // 1000}k"
    return str(tokens)


def get_context_info(data: dict) -> dict:
    if not data:
        return {}
    model_obj = data.get("model", {})
    model = model_obj.get("display_name") or model_obj.get("id", "")
    ctx = data.get("context_window", {})
    context_size = ctx.get("context_window_size", 0)
    current_usage = ctx.get("current_usage")
    if current_usage:
        tokens_used = (
            current_usage.get("input_tokens", 0)
            + current_usage.get("cache_creation_input_tokens", 0)
            + current_usage.get("cache_read_input_tokens", 0)
        )
    else:
        tokens_used = 0
    ctx_percent = (tokens_used * 100 // context_size) if context_size > 0 else 0
    return {
        "model": model,
        "tokens_used": tokens_used,
        "context_size": context_size,
        "ctx_percent": ctx_percent,
        "tokens_display": format_tokens(tokens_used),
        "context_display": format_tokens(context_size),
    }


# ── Time delta ───────────────────────────────────────────────────────

def time_until_reset(iso_timestamp: str) -> str:
    """Convert ISO timestamp to human-readable countdown."""
    if not iso_timestamp:
        return "?"
    try:
        # Strip fractional seconds for simpler parsing
        clean = iso_timestamp.split(".")[0].replace("Z", "+00:00")
        # Handle timezone offset
        if "+" not in clean and "-" not in clean[10:]:
            clean += "+00:00"
        reset_dt = datetime.fromisoformat(clean)
        now = datetime.now(timezone.utc)
        diff = (reset_dt - now).total_seconds()
        if diff <= 0:
            return "now"
        days = int(diff // 86400)
        hours = int((diff % 86400) // 3600)
        minutes = int((diff % 3600) // 60)
        if days > 0:
            return f"{days}d {hours}h"
        if hours > 0:
            return f"{hours}h {minutes}m"
        return f"{minutes}m"
    except (ValueError, TypeError):
        return "?"


# ── Progress bar ─────────────────────────────────────────────────────

def context_bar(percent: int) -> str:
    """Build a colored progress bar for context usage."""
    filled = percent // 10
    bar = "\u2588" * filled + "\u2591" * (10 - filled)
    if percent < 50:
        return f"\x1b[32m{bar} {percent}%\x1b[0m"  # green
    elif percent < 65:
        return f"\x1b[33m{bar} {percent}%\x1b[0m"  # yellow
    elif percent < 80:
        return f"\x1b[38;5;208m{bar} {percent}%\x1b[0m"  # orange
    else:
        return f"\x1b[5;31m{bar} {percent}%\x1b[0m"  # blinking red


# ── Output formatting ────────────────────────────────────────────────

def format_output(usage: dict | None, ctx: dict, fmt: str) -> str:
    model = ctx.get("model", "")
    ctx_pct = ctx.get("ctx_percent")
    tokens_disp = ctx.get("tokens_display")
    ctx_disp = ctx.get("context_display")

    five_h_pct = None
    seven_d_pct = None
    five_h_reset = "?"
    seven_d_reset = "?"

    if usage:
        five_h = usage.get("five_hour", {})
        seven_d = usage.get("seven_day", {})
        raw = five_h.get("utilization")
        if raw is not None:
            five_h_pct = round(raw)
        raw = seven_d.get("utilization")
        if raw is not None:
            seven_d_pct = round(raw)
        five_h_reset = time_until_reset(five_h.get("resets_at", ""))
        seven_d_reset = time_until_reset(seven_d.get("resets_at", ""))

    if fmt == "json":
        out = {"model": model}
        if five_h_pct is not None:
            out["five_hour_percent"] = five_h_pct
            out["five_hour_reset"] = five_h_reset
        if seven_d_pct is not None:
            out["seven_day_percent"] = seven_d_pct
            out["seven_day_reset"] = seven_d_reset
        if ctx_pct is not None:
            out["context_percent"] = ctx_pct
            out["tokens_used"] = ctx.get("tokens_used", 0)
            out["context_size"] = ctx.get("context_size", 0)
        return json.dumps(out, indent=2)

    parts = [model] if model else []

    if five_h_pct is not None:
        parts.append(f"d:{five_h_pct}% ({five_h_reset})")
    if seven_d_pct is not None:
        parts.append(f"w:{seven_d_pct}% ({seven_d_reset})")

    if fmt == "compact":
        if ctx_pct is not None:
            parts.append(context_bar(ctx_pct))
        return " \u00b7 ".join(parts) if parts else "N/A"

    # default
    if ctx_pct is not None:
        parts.append(f"ctx: {context_bar(ctx_pct)} ({tokens_disp}/{ctx_disp})")
    return " | ".join(parts) if parts else "N/A"


# ── Main ─────────────────────────────────────────────────────────────

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--update":
        do_cache_update()
        return

    fmt = sys.argv[1] if len(sys.argv) > 1 else "default"

    # --capture: save real stdin for later replay via make run
    capture = "--capture" in sys.argv
    if capture:
        sys.argv.remove("--capture")
        fmt = sys.argv[1] if len(sys.argv) > 1 else "default"

    stdin_data = parse_stdin_json()
    if capture and stdin_data:
        STDIN_CAPTURE.parent.mkdir(parents=True, exist_ok=True)
        STDIN_CAPTURE.write_text(json.dumps(stdin_data, indent=2))

    # --replay: use previously captured stdin (for make run)
    if not stdin_data and "--replay" in sys.argv:
        sys.argv.remove("--replay")
        fmt = sys.argv[1] if len(sys.argv) > 1 else "default"
        if STDIN_CAPTURE.exists():
            stdin_data = json.loads(STDIN_CAPTURE.read_text())

    ctx_info = get_context_info(stdin_data)

    # Stale-while-revalidate
    if cache_is_valid():
        debug("using fresh cache")
        usage = load_cache()
    elif CACHE_FILE.exists():
        debug("using stale cache, refreshing in background")
        usage = load_cache()
        start_background_update()
    else:
        debug("no cache, blocking fetch")
        usage = fetch_usage()
        if usage:
            save_cache(usage)

    print(format_output(usage, ctx_info, fmt))


if __name__ == "__main__":
    main()
